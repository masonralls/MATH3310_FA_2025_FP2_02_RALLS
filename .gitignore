# Repository-level .gitignore

# Virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Jupyter
.ipynb_checkpoints/
# Optionally ignore notebook outputs (uncomment if desired)
# *.ipynb

# Data directories (commonly large files)
/data/
Data/

# IDEs and editors
.vscode/
.idea/

# System files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log

# Distribution/build
build/
dist/
*.egg-info/

# Wheel/pip artifacts
pip-wheel-metadata/
pip-delete-this-directory.txt

# Test and cache
.pytest_cache/
.cache/
